# Supabase (브라우저에서도 쓰는 공개 값이라 VITE_ 접두사)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Claude API (서버 함수 전용. VITE_ 접두사를 절대 붙이지 않기)
ANTHROPIC_API_KEY=
# 선택: 비워 두면 claude-haiku-5-5
ANTHROPIC_MODEL=

# 포스터 그림 (서버 함수 전용. VITE_ 접두사를 절대 붙이지 않기)
GEMINI_API_KEY=
# 선택: 비워 두면 gemini-3.1-flash-image. 쓸 수 있는 이름은 npm run check:gemini
GEMINI_IMAGE_MODEL=
